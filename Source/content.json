    "N301": {
      "mechanic": "explore",
      "targets": [
        {
          "id": "lantern",
          "x": 0.3,
          "y": 0.35,
          "title": "幽都名灯",
          "text": "灯上写着一个模糊的名字。烛光经过时，它又清晰了一瞬。"
