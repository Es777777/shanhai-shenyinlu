        [
          "玄曜",
          "记住一切……原来人的心装不下那么多。",
          3
        ],
        [
          "旁白",
          "他将笔放下。不灭烛仍在燃烧，而另一半卷页正从雾中传来微光。",
          0
        ]
      ]
    },
