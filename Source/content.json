      "unlocks": [
        "xiangliu"
      ],
      "lines": [
        [
          "相柳",
          "你以名镇物。若我的名字本身就是痛苦，你也要留下它吗？",
          0
        ],
        [
          "玄曜",
          "失了名，你便会消散。",
          3
        ],
        [
          "相柳",
          "那是你的恐惧，还是我的愿望？",
          2
        ],
        [
          "旁白",
          "笔尖悬在卷上。九首的影子在幽雾中时聚时散。",
          4
        ]
      ]
