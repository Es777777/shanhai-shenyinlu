        "xuanyao",
        "wuxian"
      ],
      "unlocks": [
        "wuxian"
      ],
      "choices": [
        {
          "id": "release",
          "text": "助他放下执念",
          "to": "N301",
          "delta": 0,
          "toward": false,
          "reply": "玄曜将木牌轻轻放回祭坛。名字仍在，巫咸终于松开了紧握的手。"
        },
        {
          "id": "remember",
          "text": "陪他守住旧名",
          "to": "N301",
          "delta": 0,
          "toward": false,
          "reply": "玄曜与巫咸一同念过旧名。记忆得到回应，不再只是一个人的重负。"
        }
      ],
      "lines": [
        [
          "旁白",
          "巫咸的祭坛上，亡者的木牌层层叠起。",
          3
        ],
        [
          "巫咸",
          "少念一遍，我就怕他们再也回来不了。",
          2
        ],
        [
          "玄曜",
          "你记住了他们，却多久没有睡过一个安稳的夜了？",
          0
        ],
        [
          "巫咸",
          "若连我也放下，还有谁记得？",
          1
        ]
      ]
