      "lines": [
        [
          "玄曜",
          "相柳。我记住你的名字，也记住你曾问过我的话。",
          4
        ],
        [
          "旁白",
          "朱墨落下，躁动的九重影子渐渐安定。卷页却比方才更沉了一分。",
          0
