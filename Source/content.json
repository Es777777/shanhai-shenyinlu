{
  "nodes": {
    "N001": {
      "lines": [
        [
          "旁白",
          "天穹裂开时，先消失的不是山川，而是它们的名字。",
          0
        ],
        [
          "玄曜",
          "那座山……方才还在。我记得它的轮廓，却想不起它的名。",
          2
        ],
        [
          "白泽",
          "名字被忘，形体即灭。暗潮已经漫过天缺。",
          2
        ],
        [
          "灵曦",
          "若将所有名字留下，就能止住暗潮吗？",
          0
        ],
        [
          "白泽",
          "这答案，藏在两卷残页之间。执卷而行，亲眼去看。",
          4
        ],
        [
          "旁白",
          "一卷映着朱光，一卷泛起青雾。玄曜与灵曦各自接过半卷山海。",
          4
        ]
      ],
      "unlocks": [
        "baize",
        "scroll"
      ]
    },
    "N002": {
      "background": "tianque",
      "characters": [
        "xuanyao",
        "lingxi"
      ],
      "lines": [
        [
          "玄曜",
          "我去北方。扶桑树下，或许还有未被吞没的古名。",
          0
        ],
        [
          "灵曦",
          "我往丹穴。若遗忘也有它的道理，我想听一听。",
          4
        ],
        [
          "旁白",
          "双卷分途，此行的见闻将成为你的选择。",
          4
        ]
      ]
    },
    "N101": {
      "mechanic": "explore",
      "targets": [
        {
          "id": "tree",
          "x": 0.32,
          "y": 0.45,
          "title": "扶桑古纹",
          "text": "树皮上，古老的名字随晨光一明一灭。"
        },
        {
          "id": "crow",
          "x": 0.73,
          "y": 0.29,
          "title": "枝上金乌",
          "text": "三足金乌栖在高枝，衔起一点金光。玄曜将它的名字记入卷中。"
        }
      ],
      "unlocks": [
        "fusang",
        "jinwu"
      ],
      "lines": [
        [
          "旁白",
          "扶桑托起初日，枝叶如金，层云在树根下缓缓流动。",
          0
        ],
        [
          "玄曜",
          "光还在。只要有人记得，金乌便不会消失。",
          2
        ],
        [
          "白泽",
          "先看清它，再写下它的名字。记名不是占有。",
          0
        ]
      ]
    },
    "N102": {
      "background": "fusang",
      "characters": [
        "xuanyao",
        "baize"
      ],
      "mechanic": "trace",
      "lines": [
        [
          "白泽",
          "以名显形，须让每一笔都有来处。跟着墨痕，写下“金乌”。",
          4
        ],
        [
          "玄曜",
          "若写错了呢？",
          4
        ],
        [
          "白泽",
          "收笔，再来。名字不催促真心。",
          0
        ]
      ]
    },
    "N103": {
      "characters": [
        "xuanyao"
      ],
      "unlocks": [
        "scroll"
      ],
      "lines": [
        [
          "旁白",
          "最后一笔落定，枝头的金影振翅而起。",
          2
        ],
        [
          "玄曜",
          "金乌。原来被唤回的名字，也会回应。",
          0
        ],
        [
          "旁白",
          "金乌衔来一枚残简。纸上山川尚缺半边，余下的纹路却温暖如初日。",
          1
        ]
      ]
    },
