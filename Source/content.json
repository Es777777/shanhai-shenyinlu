      "background": "fusang",
      "characters": [
        "xuanyao"
      ],
      "mechanic": "mount",
      "unlocks": [
        "jinwu"
      ],
      "lines": [
        [
          "玄曜",
          "将拓片装入册中，往后就不必只靠记忆。",
          0
        ],
        [
          "白泽",
          "册页记下形影，也记下相遇。将金乌拓片拖入装裱框，再落印。",
          1
        ]
      ]
