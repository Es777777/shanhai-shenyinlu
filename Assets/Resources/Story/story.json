      "effects": "落笔晕染动画"
    },
    {
      "id": "N103",
      "title": "第一章·金乌试笔",
      "plot": "P_XUANYAO",
      "chapter": "第一章 扶桑",
      "kind": "剧情",
      "summary": "写名显形：金乌现身衔来一枚残简。",
      "background": "fusang",
      "characters": [
        "xuanyao"
      ],
      "music": "fusang",
