        "baize"
      ],
      "music": "fusang",
      "changes": [
        {
          "key": "mcv",
          "op": "add",
          "value": 8
        }
      ],
      "lines": [
        {
          "speaker": "白泽",
          "text": "以名显形，须让每一笔都有来处。跟着墨痕，写下“金乌”。"
        },
        {
          "speaker": "玄曜",
          "text": "若写错了呢？"
        },
        {
          "speaker": "白泽",
          "text": "收笔，再来。名字不催促真心。"
        }
      ],
      "mechanic": "trace",
      "targets": [],
      "choices": [],
