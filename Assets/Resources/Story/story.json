    {
      "id": "N202",
      "title": "第二章·烛阴衔烛",
      "plot": "P_XUANYAO",
      "chapter": "第二章 钟山",
      "kind": "剧情",
      "summary": "01 烛阴衔不灭烛现身。\n02 告知：烛旺则名存，烛微则名危。",
      "background": "zhongshan",
      "characters": [
        "xuanyao",
        "zhuyin"
      ],
      "music": "ming",
      "changes": [
        {
          "key": "candle",
          "op": "set",
          "value": 3
        }
      ],
      "lines": [
        {
          "speaker": "旁白",
          "text": "洞中，烛阴缓缓睁眼。长躯盘在冰石间，衔烛如衔一颗不肯熄灭的星。"
        },
        {
          "speaker": "烛阴",
          "text": "烛旺则名存，烛微则名危。带上这支不灭烛。"
        },
        {
          "speaker": "玄曜",
          "text": "既称不灭，为什么还会微弱？"
        },
        {
          "speaker": "烛阴",
          "text": "火可续，执火之人却会疲倦。记住这一点。"
        }
      ],
      "mechanic": "",
      "targets": [],
      "choices": [],
      "unlocks": [
        "zhuyin",
        "candle"
      ],
      "effects": "烛光呼吸明暗"
    },
    {
      "id": "N203",
      "title": "第二章·巫咸执念",
      "plot": "P_XUANYAO",
      "chapter": "第二章 钟山",
      "kind": "选择",
      "summary": "巫咸强记亡者之名而成执念，玄曜可助其放下或固化其记。",
