    {
      "id": "N201",
      "title": "第二章·钟山雪径",
      "plot": "P_XUANYAO",
      "chapter": "第二章 钟山",
      "kind": "剧情",
      "summary": "01 玄曜踏雪北上。\n02 冰封铭文若隐若现。",
      "background": "zhongshan",
      "characters": [
        "xuanyao"
      ],
      "music": "ming",
      "changes": [],
      "lines": [
        {
          "speaker": "旁白",
          "text": "北上的雪径越走越静。钟山覆着千年寒霜，连脚步也被雪吞没。"
        },
        {
          "speaker": "玄曜",
          "text": "那些冰下的字还没有消失。洞里一定有人守着它们。"
        }
      ],
      "mechanic": "explore",
      "targets": [
        {
          "id": "inscription",
          "x": 0.3,
          "y": 0.48,
          "title": "冰封铭文",
          "text": "冰层下有断续的铭文，字痕像一条盘旋的长蛇。"
        },
        {
          "id": "cave",
          "x": 0.78,
          "y": 0.43,
          "title": "洞府微光",
          "text": "风雪尽头，一点烛光仍在。玄曜沿着石阶走入洞府。"
        }
      ],
      "choices": [],
      "unlocks": [],
      "effects": "飘雪粒子"
