  "nodes": [
    {
      "id": "N001",
      "title": "序章·天缺惊变",
      "plot": "P_MAIN",
      "chapter": "序章",
      "kind": "起点",
      "summary": "01 天穹裂开，暗潮吞没山川之名。\n02 白泽告知：名字被忘，形体即灭。\n03 双卷残页显现，二人各自接卷。",
      "background": "tianque",
      "characters": [
        "xuanyao",
        "lingxi",
        "baize"
      ],
      "music": "prologue",
      "changes": [],
      "lines": [
        {
          "speaker": "旁白",
          "text": "天穹裂开时，先消失的不是山川，而是它们的名字。"
        },
        {
          "speaker": "玄曜",
          "text": "那座山……方才还在。我记得它的轮廓，却想不起它的名。"
        },
        {
          "speaker": "白泽",
          "text": "名字被忘，形体即灭。暗潮已经漫过天缺。"
        },
        {
          "speaker": "灵曦",
          "text": "若将所有名字留下，就能止住暗潮吗？"
        },
        {
          "speaker": "白泽",
          "text": "这答案，藏在两卷残页之间。执卷而行，亲眼去看。"
        },
        {
          "speaker": "旁白",
          "text": "一卷映着朱光，一卷泛起青雾。玄曜与灵曦各自接过半卷山海。"
        }
      ],
      "mechanic": "",
      "targets": [],
      "choices": [],
      "unlocks": [
        "baize",
        "scroll"
      ],
      "effects": "暗潮粒子轻档；开场淡入1秒"
    },
    {
      "id": "N002",
      "title": "序章·双生启程",
      "plot": "P_MAIN",
      "chapter": "序章",
      "kind": "选择",
      "summary": "显示两项选择：随玄曜北上扶桑／随灵曦东行丹穴。",
      "background": "tianque",
      "characters": [
        "xuanyao",
        "lingxi"
      ],
      "music": "prologue",
      "changes": [],
      "lines": [
        {
          "speaker": "玄曜",
          "text": "我去北方。扶桑树下，或许还有未被吞没的古名。"
        },
        {
          "speaker": "灵曦",
          "text": "我往丹穴。若遗忘也有它的道理，我想听一听。"
        },
        {
          "speaker": "旁白",
          "text": "双卷分途，此行的见闻将成为你的选择。"
        }
      ],
      "mechanic": "",
      "targets": [],
      "choices": [],
      "unlocks": [],
      "effects": "选中高亮0.3秒"
    },
    {
      "id": "N101",
      "title": "第一章·扶桑初遇",
      "plot": "P_XUANYAO",
      "chapter": "第一章 扶桑",
      "kind": "剧情",
      "summary": "01 玄曜抵达晨曦神木。\n02 目睹金乌栖枝，记下其名。",
      "background": "fusang",
      "characters": [
        "xuanyao",
        "baize"
      ],
      "music": "fusang",
      "changes": [
        {
          "key": "mcv",
          "op": "add",
          "value": 8
        }
      ],
      "lines": [
        {
          "speaker": "旁白",
          "text": "扶桑托起初日，枝叶如金，层云在树根下缓缓流动。"
        },
        {
          "speaker": "玄曜",
          "text": "光还在。只要有人记得，金乌便不会消失。"
        },
        {
          "speaker": "白泽",
          "text": "先看清它，再写下它的名字。记名不是占有。"
        }
      ],
      "mechanic": "explore",
      "targets": [
        {
          "id": "tree",
          "x": 0.32,
          "y": 0.45,
          "title": "扶桑古纹",
          "text": "树皮上，古老的名字随晨光一明一灭。"
        },
        {
          "id": "crow",
          "x": 0.73,
          "y": 0.29,
          "title": "枝上金乌",
          "text": "三足金乌栖在高枝，衔起一点金光。玄曜将它的名字记入卷中。"
        }
      ],
      "choices": [],
      "unlocks": [
        "fusang",
        "jinwu"
      ],
      "effects": "光尘粒子；转场淡入0.5秒"
    },
    {
      "id": "N102",
      "title": "第一章·白泽授名",
      "plot": "P_XUANYAO",
      "chapter": "第一章 扶桑",
      "kind": "玩法",
      "summary": "墨韵落笔教学：白泽示范以名显形，玩家临摹「金乌」二字。",
      "background": "fusang",
      "characters": [
