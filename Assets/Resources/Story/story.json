      "lines": [
        {
          "speaker": "旁白",
          "text": "最后一笔落定，枝头的金影振翅而起。"
        },
        {
          "speaker": "玄曜",
          "text": "金乌。原来被唤回的名字，也会回应。"
        },
        {
          "speaker": "旁白",
          "text": "金乌衔来一枚残简。纸上山川尚缺半边，余下的纹路却温暖如初日。"
        }
      ],
      "mechanic": "",
      "targets": [],
