  "codex": [
    {
      "id": "baize",
      "title": "白泽",
      "category": "神灵",
      "art": "baize",
      "text": "知万物之名的讲述者。它将残卷交予玄曜与灵曦，让答案从旅途里生长。"
    },
    {
      "id": "fusang",
      "title": "扶桑",
      "category": "山川",
      "art": "bg:fusang",
      "text": "承接晨光的神木。金乌栖枝，古名沿树纹流转。"
    },
    {
      "id": "jinwu",
      "title": "金乌",
      "category": "神灵",
      "art": "bg:fusang",
      "text": "栖于扶桑的三足神鸟。玄曜写下它的名字，它衔来一枚山海残简。"
    },
    {
      "id": "phoenix",
      "title": "凤凰",
      "category": "神灵",
      "art": "bg:danxue",
      "text": "浴火而不留旧痕。灵曦从它身上看见放下的另一种美。"
    },
    {
      "id": "zhuyin",
      "title": "烛阴",
      "category": "神灵",
      "art": "zhuyin",
      "text": "人面蛇身，衔不灭之烛。守护名字，也提醒执火之人懂得自己的限度。"
    },
    {
      "id": "wuxian",
      "title": "巫咸",
      "category": "人物",
      "art": "wuxian",
      "text": "反复念诵亡者名字的巫者。记忆既是连接，也是他难以放下的重负。"
    },
    {
      "id": "wupeng",
      "title": "巫彭",
      "category": "人物",
      "art": "wuxian2",
      "text": "学会与亡者和解的巫者。他相信相遇留下的改变，无须日日点名。"
    },
    {
      "id": "xiangliu",
      "title": "相柳",
      "category": "神灵",
      "art": "xiangliu",
      "text": "幽都中的九首之影。它向执卷者追问：留下一个名字，是否也留下了痛苦？"
    },
    {
      "id": "wangxiang",
      "title": "罔象",
      "category": "神灵",
      "art": "wangxiang",
      "text": "无面水影，不辨善恶。它执行遗忘，如水流执行流动。"
    },
    {
      "id": "dinv",
      "title": "帝女",
      "category": "神灵",
      "art": "dinv",
      "text": "泣血化桑的灵体。她的桑叶记着一句话：有些名字，放下也是安放。"
    },
    {
      "id": "gonggong",
      "title": "共工",
      "category": "神灵",
      "art": "gonggong",
      "text": "不周山回溯中的怒神。山柱可折，天地的规律并未因此改变。"
    },
    {
      "id": "scroll",
      "title": "山海古卷",
      "category": "道具",
      "art": "bg:finale",
      "text": "一卷记名，一卷存形。分开时是残页，相照时才得见山海。"
    },
    {
      "id": "candle",
      "title": "不灭烛",
      "category": "道具",
      "art": "zhuyin",
      "text": "烛旺则名存，烛微则名危。火有三阶段，随本次旅程保存。"
    },
    {
      "id": "feather",
      "title": "凤翎",
      "category": "道具",
      "art": "bg:danxue",
      "text": "凤凰留下的一点余温，护灵曦穿过凶犁旱地。"
    },
    {
      "id": "mulberry",
      "title": "帝女桑叶",
      "category": "道具",
      "art": "dinv",
      "text": "叶脉映出通向幽都的路。叶落，也可以是一种安放。"
    },
    {
      "id": "memory",
      "title": "拾遗之页",
      "category": "见闻",
      "art": "bg:youdu",
      "text": "玄曜遗落的记忆由灵曦拾起。记忆可以由他人珍藏，不必全由一人承担。"
    },
    {
      "id": "truth",
      "title": "记与忘的规律",
      "category": "见闻",
      "art": "bg:buzhou",
      "text": "无名即灭并非阴谋。双卷互补，记与忘是同一片山海中的两种流动。"
    }
  ]
}
